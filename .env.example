NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=code_crafter_x
DB_SSL_ENABLED=false
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

JWT_SECRET=change-me
ENCRYPTION_KEY=replace-with-at-least-32-random-bytes

# Keep false for cloud deployments. Enable only when this backend is intentionally
# allowed to call attendance-vendor APIs on private/LAN addresses.
ATTENDANCE_PULL_ALLOW_PRIVATE_NETWORKS=false

HR_BANGLA_FONT_PATH=/opt/app/fonts/NotoSansBengali-Regular.ttf
HR_ENGLISH_FONT_PATH=/opt/app/fonts/NotoSans-Regular.ttf

UPLOAD_BASE_DIR=uploads
PUBLIC_ASSETS_DIR=public
